{
  "name": "@t3tools/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Ditto Desktop with local memory, Pi coding, chats and cloud connections",
  "author": "Ditto",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "ensure:electron": "node scripts/ensure-electron-runtime.mjs",
    "start": "node scripts/start-ditto.mjs",
    "typecheck": "tsc-rs --noEmit",
    "test": "vp test run --passWithNoTests",
    "smoke-test": "node scripts/smoke-test.mjs",
    "start:workbench": "node scripts/start-electron.mjs",
    "build:web": "node scripts/build-web.cjs",
    "build:native": "node scripts/build-native.cjs",
    "build:computer": "node scripts/build-computer.cjs",
    "build:channels": "node scripts/build-channels.cjs",
    "scan:local": "node scripts/scan-local.cjs",
    "build:ditto": "node scripts/build-web.cjs && node scripts/build-channels.cjs && node scripts/build-computer.cjs && node scripts/build-native.cjs",
    "test:ditto": "node --experimental-strip-types --test tests/*.node-test.cjs",
    "dist:ditto:mac": "node scripts/dist-ditto.cjs"
  },
  "dependencies": {
    "@clerk/electron": "catalog:",
    "@clerk/electron-passkeys": "catalog:",
    "@crowecawcaw/xa11y": "0.13.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@effect/platform-node": "catalog:",
    "@heyditto/cli": "2.22.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@napi-rs/keyring": "^1.3.0",
    "@t3tools/client-runtime": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/ssh": "workspace:*",
    "@t3tools/tailscale": "workspace:*",
    "@xai-official/grok": "^1.0.46",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dbus-next": "0.10.2",
    "effect": "catalog:",
    "electron": "44.9.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "electron-webauthn": "catalog:",
    "ffi-rs": "1.3.2",
    "playwright-core": "1.60.0",
    "qrcode": "^1.5.4",
    "react-grab": "^0.1.32",
    "tldts": "catalog:",
    "typebox": "^1.3.27",
    "ws": "8.22.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "acorn": "8.16.0",
    "cross-env": "^10.1.0",
    "electron-builder": "26.15.6",
    "tailwindcss": "^4.0.0",
    "vite-plus": "catalog:"
  },
  "productName": "Ditto Desktop"
}
