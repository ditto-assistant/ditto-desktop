{
  "name": "hey-ditto-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Ditto desktop with Pi and private Mac memory",
  "author": "Ditto",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:native": "node scripts/build-native.cjs",
    "scan:local": "node scripts/scan-local.cjs",
    "test": "node --test tests/*.test.cjs",
    "dist:mac": "electron-builder --mac dir --arm64 --config electron-builder.yml"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
